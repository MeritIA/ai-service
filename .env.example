# ---------------------------------------------------------------------------
# MeritIA ai-service — plantilla de variables de entorno
#
# Copia a `.env` y rellena. `.env` esta en .gitignore y NUNCA se sube.
#
# Fijate en lo que NO hay: ni base de datos, ni almacenamiento de objetos, ni
# claves del backend. El servicio no las necesita, y lo que no tiene no lo
# puede filtrar si alguien lo compromete (paquete 4.4).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Puerto publicado en el host por compose.yaml.
HOST_PORT=13100

# Secreto compartido con el backend, que alli se llama AI_SERVICE_API_KEY.
# 32 bytes aleatorios en hexadecimal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_DE_ACCESO=

# Proveedor de modelo: gemini | simulado.
# El simulado devuelve puntaje 0 sin llamar a ningun modelo: sirve para
# desarrollar sin API key y esta PROHIBIDO en produccion.
PROVEEDOR_IA=simulado

# Solo con PROVEEDOR_IA=gemini. Se crea en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Tiempo maximo por llamada al proveedor. Menor que el del backend
# (COLA_TIMEOUT_MS=120000) para que el backend reciba una respuesta y no un corte.
TIEMPO_MAXIMO_MS=90000
